PORT=5000
# Atlas: URL-encode reserved characters in the database username/password.
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_HOST>/<DATABASE_NAME>?retryWrites=true&w=majority
# Local alternative (MongoDB must run as a replica set for transactions):
# MONGODB_URI=mongodb://127.0.0.1:27017/civicpulse?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
